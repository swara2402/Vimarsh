# Copy values into the environment; do not commit real secrets or model artifacts.
VIMARSH_RELIABILITY_BUNDLE=research/models/reliability/wine_quality_reliability_bundle.joblib
VIMARSH_MAX_ACCEPTABLE_RISK=0.5
VIMARSH_CORS_ORIGINS=http://localhost:5173
# Required to enable /v1/research/* routes. Generate a long random value.
VIMARSH_RESEARCH_API_TOKEN=
VIMARSH_OUTCOME_LEDGER=research/data/action_outcomes.jsonl

# Optional: sqlite enables transactional multi-process-safe writes. Defaults to jsonl for legacy compatibility.
VIMARSH_OUTCOME_LEDGER_BACKEND=jsonl
