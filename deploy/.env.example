# Optional. Set a strong random token only if you need the protected research API.
# Never put this token in frontend variables or commit a populated .env file.
VIMARSH_RESEARCH_API_TOKEN=

# Host directory containing wine_quality_reliability_bundle.joblib
VIMARSH_MODEL_DIR=./research/models/reliability

# Optional outcome storage backend. JSONL remains the default.
# For SQLite, use:
# VIMARSH_OUTCOME_LEDGER_BACKEND=sqlite
# VIMARSH_OUTCOME_LEDGER=/app/research/data/action_outcomes.sqlite3
VIMARSH_OUTCOME_LEDGER_BACKEND=jsonl
VIMARSH_OUTCOME_LEDGER=/app/research/data/action_outcomes.jsonl
